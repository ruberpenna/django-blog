# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요
DJANGO_SECRET_KEY=change-me

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# 개발 PC: DJANGO_DEBUG=True / 운영 서버: DJANGO_DEBUG=False
DJANGO_DEBUG=True
# 접속 허용 도메인 (쉼표로 구분). 운영 예: myblog.duckdns.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 운영 서버에서 Caddy(HTTPS) 뒤에 둘 때 True
DJANGO_HTTPS=False

# 새 댓글 텔레그램 알림 (비워 두면 꺼짐). 설정 방법: deploy\README.md "댓글 텔레그램 알림"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
