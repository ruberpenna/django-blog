# 블로그 앞단 웹서버 (정적/업로드 파일 제공, Django로 전달)
# HTTPS는 앞단의 Nginx Proxy Manager(NPM)가 처리하고, 이 PC의 8123 포트로 HTTP 전달
# 프로젝트 경로는 서비스 환경변수로 넣음 (deploy\README.md 참고)
#   BLOG_ROOT = E:/django_blog   (슬래시 / 사용)

{
	servers {
		# NPM이 보낸 X-Forwarded-Proto(https)를 Django까지 전달
		trusted_proxies static private_ranges
		# 방문자 IP는 X-Forwarded-For 오른쪽부터 신뢰할 수 없는 첫 주소 (왼쪽 값은 위조 가능)
		trusted_proxies_strict
	}
}

http://:8123 {
	encode gzip

	handle_path /static/* {
		root * {$BLOG_ROOT}/static
		file_server
	}

	handle_path /media/* {
		root * {$BLOG_ROOT}/media
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			# Waitress 는 X-Forwarded-For 를 지우므로 실제 방문자 IP를 별도 헤더로 전달 (댓글 작성 횟수 제한용)
			header_up X-Real-IP {client_ip}
		}
	}
}
